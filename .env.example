# Podium environment template — copy to .env and edit.
#
# docker-compose.yml forwards every var defined here into the podium
# container. The compose file already ships safe fallback defaults
# (admin / change-me-now) so `docker compose up` works without an .env,
# but for any local work you should override the admin password.
#
# Never commit a real .env file. The repo's .gitignore covers .env
# and .env.local.

# The default admin account seeded on first boot. Username and password
# are written into the SQLite database on startup; subsequent boots will
# NOT overwrite a non-empty password (see auth.SeedAdmin).
PODIUM_ADMIN_USERNAME=admin
PODIUM_ADMIN_PASSWORD=change-me
